# rahasia -- API key nggak boleh ke-commit
.env
.env.local
!.env.example

# konfigurasi lokal editor/agent
.claude/
.idea/
.vscode/

# virtualenv
.venv/
.venv-*/

# artefak tooling Flet (dibuat otomatis, aman dihapus)
.flet/
app/.flet/
build/

__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/
.DS_Store

# artefak model yang bisa dibangun ulang dari datasets/
# (bikin: python tools/train_duration_model.py)
models/artifacts/*.joblib

# artefak registry disimpan di artifact store, bukan sebagai source code
ml/registry/artifacts/*
!ml/registry/artifacts/.gitkeep

# export Supabase/raw outcome berisi data pengguna dan UUID pseudonim
datasets/private/
datasets/exports/
reports/private/
*.supabase-export.json
*.user-outcomes-export.json
