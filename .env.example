# Salin file ini jadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# `.env` sudah masuk .gitignore -- jangan pernah commit key asli.

# API key Gemini buat fitur "Pecah Tugas" (AI Task Decomposer).
# Ambil gratis di https://aistudio.google.com/apikey
# Kosongin aja kalau nggak dipakai -- app otomatis fallback ke template
# rule-based dan tetap jalan normal.
GEMINI_API_KEY=
