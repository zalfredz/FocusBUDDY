# Provider Kalem berjalan di backend Flet. Secret hanya di environment hosting.
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Opsional: gemini atau openai. Kalau kosong, KALEM memilih provider audio yang tersedia.
KALEM_SPEECH_PROVIDER=

# Dua nilai ini publik; keamanan row tetap berasal dari Auth + RLS.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domain HTTPS final dari hosting Flet Web, tanpa slash di belakang.
FOCUSBUDDY_PUBLIC_URL=https://focusbuddy-bw0z.onrender.com
SUPABASE_REDIRECT_URI=https://focusbuddy-bw0z.onrender.com/auth/callback
# Runtime production bersifat inference-only. Render juga terdeteksi otomatis.
# FOCUSBUDDY_RUNTIME_MODE=production

# Diisi hanya setelah model Duration dipromosikan dan checksum manifest disetujui.
# FOCUSBUDDY_DURATION_MODEL_PATH=/opt/focusbuddy/models/duration-approved.joblib

# Gate Phase 4; 30 adalah minimum dan dapat dinaikkan setelah evaluasi.
FOCUSBUDDY_PERSONALIZATION_MIN_OUTCOMES=30
