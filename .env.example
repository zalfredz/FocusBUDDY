# Salin file ini jadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# `.env` sudah masuk .gitignore -- jangan pernah commit key asli.

# Provider AI buat "Pecah Tugas" & kartu rekomendasi -- "gemini", "openai",
# atau "deepseek". Kosongin aja: app nebak sendiri dari key mana yang keisi
# di bawah (urutan menang Gemini > OpenAI > DeepSeek kalau lebih dari satu
# keisi). Cuma perlu diisi kalau mau MAKSA satu provider meski ada key lain.
AI_PROVIDER=

# API key Gemini. Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API=

# API key OpenAI. Ambil di https://platform.openai.com/api-keys
OPENAI_API_KEY=

# API key DeepSeek. Ambil di https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Kosongin semuanya kalau nggak dipakai -- app otomatis fallback ke
# template rule-based dan tetap jalan normal.
